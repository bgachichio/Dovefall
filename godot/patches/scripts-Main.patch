 func _start_run(mode: String, daily: bool) -> void:
+	# The very first Play of this install detours through the tutorial: choose
+	# a name, then learn the rest by playing a real (local-only) run.
+	if int(SaveData.data.get("tut_done", 0)) == 0:
+		_pending_mode = mode
+		_pending_daily = daily
+		var n := Control.new()
+		n.set_script(TutorialName)
+		_swap(n)
+		n.done.connect(_on_tutorial_name_done)
+		return
+	_begin_run(mode, daily, false)
+
+
+func _begin_run(mode: String, daily: bool, tut: bool) -> void:
 	_swap(null)
 	game.visible = true
 	hud_bar.visible = true
-	game.start(mode, daily)
+	game.start(mode, daily, tut)
+
+
+func _on_tutorial_name_done() -> void:
+	_begin_run(_pending_mode, false, true)
+
+
+func _on_tutorial_finished(final_score: int) -> void:
+	SaveData.data["tut_done"] = 1
+	SaveData.write()
+	var e := Control.new()
+	e.set_script(TutorialEnd)
+	# set() rather than a property access: `e` is typed Control here, and the
+	# analyzer cannot see members of the attached script.
+	e.set("score", final_score)
+	_swap(e)
+	e.finished.connect(_after_tutorial)
+
+
+func _after_tutorial() -> void:
+	# Straight into the run they originally asked for, now for real.
+	_begin_run(_pending_mode, _pending_daily, false)
+
+
+func _open_leaderboard() -> void:
+	var l := Control.new()
+	l.set_script(Leaderboard)
+	_swap(l)
+	l.closed.connect(show_title)
+
+
+## Reached from the death screen's empty heart. Closing returns to the dead
+## run, which is still there under the overlay, waiting for a retry tap.
+func _open_respawn_shop() -> void:
+	var r := Control.new()
+	r.set_script(RespawnShop)
+	_swap(r)
+	r.closed.connect(_close_over_game)
+
+
+func _close_over_game() -> void:
+	_swap(null)
 
 
