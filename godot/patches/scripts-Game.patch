+func _heart_tapped() -> void:
+	if tutorial:
+		tut_respawns -= 1
+		respawn_used = true
+		_continue_run()
+		return
+	if Net.respawns > 0:
+		# Server-first: the guarded decrement there is what stops two devices
+		# spending the same respawn. The run continues only once it agrees.
+		Net.spend_respawn(_on_respawn_spent)
+	else:
+		shop_requested.emit()
+
+
+func _on_respawn_spent(ok: bool) -> void:
+	if not ok or st != St.DEAD:
+		return
+	respawn_used = true
+	_continue_run()
+	Analytics.log_event("iap", {"step": "respawn_used", "sku": "respawn3"})
 
 
