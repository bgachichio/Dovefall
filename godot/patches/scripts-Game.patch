+
+## Delta-encoded varints, base64. A ninety-second run is about 150 flaps, which
+## is roughly 300 bytes on the wire.
+func replay_blob() -> String:
+	var bytes := PackedByteArray()
+	var prev := 0
+	for tick in _flap_ticks:
+		var d: int = tick - prev
+		prev = tick
+		while d >= 0x80:
+			bytes.append((d & 0x7F) | 0x80)
+			d >>= 7
+		bytes.append(d)
+	return Marshalls.raw_to_base64(bytes)
 
 
