 ## cannot be broken by a hand-edited scene file with a wrong load_steps count.
 
 const PAD := 34
-const ROW := 96
+
+## Touch targets, in design units, sized against design.md 8.2: 44x44 minimum,
+## 48x48 for primary actions — and that floor is in CSS pixels, not ours.
+##
+## With stretch/aspect="keep" the 1080x1920 viewport is scaled to fit, so on the
+## smallest common phone (375 CSS px wide) one design unit is 0.347 CSS px. The
+## old ROW of 96 therefore measured 33 CSS px: comfortably illegal, and it
+## failed on every phone while passing on the tablet nobody tests with.
+##
+##   44 CSS px floor -> 127 design units
+##   48 CSS px floor -> 139 design units
+const ROW := 140          # primary actions and text fields
+const ROW_SECONDARY := 128  # segmented choices
 
 
 static func screen(title_key: String) -> VBoxContainer:
@@ -92,7 +104,7 @@
 		b.button_group = group
 		b.button_pressed = (i == current)
 		b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
-		b.custom_minimum_size = Vector2(0, 78)
+		b.custom_minimum_size = Vector2(0, ROW_SECONDARY)
 		b.add_theme_font_size_override("font_size", 28)
 		b.add_theme_stylebox_override("normal", _box(Color("#1B2536")))
 		b.add_theme_stylebox_override("hover", _box(Color("#243247")))
@@ -108,6 +120,34 @@
 	return box
 
 
+## A single-line text field. The only place in the game where a player types.
+static func field(placeholder: String, initial: String = "", max_len: int = 24) -> LineEdit:
+	var e := LineEdit.new()
+	e.placeholder_text = placeholder
+	e.text = initial
+	e.max_length = max_len
+	e.custom_minimum_size = Vector2(0, ROW)
+	e.add_theme_font_size_override("font_size", 34)
+	e.add_theme_color_override("font_color", Config.PAPER)
+	e.add_theme_stylebox_override("normal", _box(Color("#1B2536")))
+	e.add_theme_stylebox_override("focus", _box(Color("#243247")))
+	return e
+
+
+## A value the player is meant to read and copy, not edit. Wide letter spacing,
+## because the whole point of a recovery code is transcribing it correctly.
+static func field_display(text: String) -> Label:
+	var l := Label.new()
+	l.text = text
+	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	l.custom_minimum_size.y = ROW
+	l.add_theme_font_size_override("font_size", 40)
+	l.add_theme_color_override("font_color", Config.GOLD)
+	l.add_theme_constant_override("line_spacing", 10)
+	return l
+
+
 static func spacer(h: int = 20) -> Control:
 	var c := Control.new()
 	c.custom_minimum_size.y = h
