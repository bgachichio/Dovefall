+## The server owns the streak; SaveData's local count is the offline fallback.
+func _streak_days() -> int:
+	if Net.enabled() and Net.play_streak() > 0:
+		return Net.play_streak()
+	return int(SaveData.data.get("streak", {}).get("count", 0))
+
+
+func _strip_text(mode: String) -> String:
+	return "\u2605 %d      \u2691 %d      \u25C6 %d" % [
+		SaveData.best_for(mode),
+		int(SaveData.data["feathers"]),
+		_streak_days(),
+	]
+
+
+func _refresh_streak() -> void:
+	if _streak_line == null:
+		return
+	var days := _streak_days()
+	if days <= 0:
+		_streak_line.text = ""
+		return
+	var daily := Net.daily_streak() if Net.enabled() else 0
+	if daily > 1:
+		_streak_line.text = "%s: %d %s  \u00B7  %s %d" % [
+			Config.t("streak"), days, Config.t("days"), Config.t("daily"), daily]
+	else:
+		_streak_line.text = "%s: %d %s" % [Config.t("streak"), days, Config.t("days")]
