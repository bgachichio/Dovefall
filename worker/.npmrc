# Node 22 is not a preference. worker/test runs the real Worker against a real
# SQLite copy of the real schema, and node:sqlite does not exist before 22;
# wrangler 4.128 refuses to start below it. Without engine-strict, npm prints
# EBADENGINE as a warning, installs anyway, and the failure surfaces four
# stages later as seven mysterious test failures.
#
# Fail here instead, where the message says what to do.
engine-strict=true
